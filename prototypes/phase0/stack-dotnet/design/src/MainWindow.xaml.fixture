<!-- Static accessibility fixture; no local WPF compiler parsed this markup. -->
<Window
  x:Class="MiniMaxH3.StackDotnet.Fixture.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
  Title="MiniMax H3 控制平面技术栈探针"
  Language="zh-CN"
  Width="880"
  Height="680"
  MinWidth="680"
  MinHeight="520"
  automation:AutomationProperties.Name="MiniMax H3 控制平面技术栈探针">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="32">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <TextBlock FontSize="28" FontWeight="SemiBold" Text="安装位置技术探针" />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="本页只验证控制平面边界，不生成视频，也不会替用户提交 ComfyUI 队列。" />
      </StackPanel>

      <GroupBox Grid.Row="1" Margin="0,24,0,0" Header="安装位置">
        <StackPanel Margin="16">
          <TextBlock Text="建议位置" />
          <TextBox x:Name="ManagedRootText" Margin="0,6,0,12" IsReadOnly="True"
                   automation:AutomationProperties.Name="当前选择的安装位置" />
          <Button x:Name="ChooseRootButton" MinHeight="44" Padding="16,8"
                  HorizontalAlignment="Left" Content="选择安装位置"
                  automation:AutomationProperties.HelpText="打开 Windows 文件夹选择对话框" />
        </StackPanel>
      </GroupBox>

      <GroupBox Grid.Row="2" Margin="0,20,0,0" Header="技术验证">
        <StackPanel Margin="16">
          <Button x:Name="ProbeChildButton" MinHeight="44" Padding="16,8"
                  HorizontalAlignment="Left" Content="验证无害进程边界"
                  automation:AutomationProperties.HelpText="仅启动并停止固定的无害技术探针" />
          <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                     automation:AutomationProperties.LiveSetting="Polite"
                     Text="等待本地技术验证。" />
        </StackPanel>
      </GroupBox>

      <TextBlock Grid.Row="3" Margin="0,24,0,0" TextWrapping="Wrap"
                 Text="项目准备完成后，用户在可见的 ComfyUI 中点击 Run，MiniMax H3 才生成视频和原生音频。" />
    </Grid>
  </ScrollViewer>
</Window>

